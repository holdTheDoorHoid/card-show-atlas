---
import { withBase } from '../lib/urls';
interface Props {
  current: 'states' | 'series' | 'promoters';
}
const { current } = Astro.props;
const tabs = [
  { id: 'states', label: 'States and provinces', href: 'states/' },
  { id: 'series', label: 'Regular shows', href: 'series/' },
  { id: 'promoters', label: 'Organizers', href: 'promoters/' },
];
---

<nav class="chips" aria-label="Browse by" style="margin-bottom:1rem">
  {tabs.map((t) => <a class="chip" href={withBase(t.href)} aria-current={t.id === current ? 'page' : undefined} aria-pressed={t.id === current ? 'true' : 'false'} style="text-decoration:none">{t.label}</a>)}
</nav>
