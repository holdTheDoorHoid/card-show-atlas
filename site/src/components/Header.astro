---
import { withBase } from '../lib/urls';

interface Props {
  current: string;
}
const { current } = Astro.props;
const links = [
  { href: '', label: 'Find', match: (p: string) => p === '' },
  { href: 'map/', label: 'Map', match: (p: string) => p === 'map/' },
  { href: 'my-shows/', label: 'My shows', match: (p: string) => p === 'my-shows/' },
  { href: 'plan/', label: 'Plan', match: (p: string) => p === 'plan/' },
  { href: 'states/', label: 'Browse', match: (p: string) => /^(states|series|promoters|browse)\//.test(p) },
  { href: 'about/', label: 'About', match: (p: string) => p === 'about/' },
];
---

<header class="site-header">
  <div class="container">
    <a class="brand" href={withBase('')}>
      <svg viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="7" fill="#0b4f9e"></rect><rect x="7" y="6" width="14" height="19" rx="2.5" fill="#fff" transform="rotate(-8 14 15)"></rect><rect x="11" y="7" width="14" height="19" rx="2.5" fill="#ffd34d" stroke="#0b4f9e" stroke-width="1.5" transform="rotate(8 18 16)"></rect><circle cx="18" cy="15" r="3.2" fill="#0b4f9e"></circle></svg>
      Card Show Atlas
    </a>
    <nav class="site-nav" aria-label="Main">
      {links.map((l) => <a href={withBase(l.href)} aria-current={l.match(current) ? 'page' : undefined}>{l.label}</a>)}
    </nav>
    <button type="button" class="btn btn-small theme-toggle" id="theme-toggle" aria-label="Colour theme">Theme</button>
  </div>
</header>

<script>
  const KEY = 'csa.theme.v1';
  const btn = document.getElementById('theme-toggle');
  const order = ['auto', 'light', 'dark'] as const;
  function read(): (typeof order)[number] {
    try {
      const v = localStorage.getItem(KEY);
      if (v === 'light' || v === 'dark') return v;
    } catch {
      /* storage blocked: stay on auto */
    }
    return 'auto';
  }
  function apply(mode: (typeof order)[number]) {
    if (mode === 'auto') document.documentElement.removeAttribute('data-theme');
    else document.documentElement.setAttribute('data-theme', mode);
    if (btn) {
      btn.textContent = mode === 'auto' ? 'Theme: auto' : mode === 'light' ? 'Theme: light' : 'Theme: dark';
      btn.setAttribute('aria-label', `Colour theme: ${mode === 'auto' ? 'follow my device' : mode}. Change.`);
    }
  }
  let mode = read();
  apply(mode);
  btn?.addEventListener('click', () => {
    mode = order[(order.indexOf(mode) + 1) % order.length] ?? 'auto';
    try {
      if (mode === 'auto') localStorage.removeItem(KEY);
      else localStorage.setItem(KEY, mode);
    } catch {
      /* storage blocked: the choice lasts until the page closes */
    }
    apply(mode);
    window.dispatchEvent(new CustomEvent('csa-theme'));
  });
</script>
